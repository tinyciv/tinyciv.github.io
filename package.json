{
  "name": "tinyciv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "benchmark:ai": "node scripts/benchmark-faction-ai.mjs",
    "lab:navigation": "node scripts/build-navigation-lab.mjs",
    "lab:world": "node scripts/build-world-generation-lab.mjs",
    "lab:fractal": "node scripts/build-fractal-gallery.mjs",
    "gallery:puny": "python3 scripts/build-puny-gallery.py",
    "test:browser": "node scripts/browser-check.mjs",
    "test:pixi": "node scripts/check-pixi-rendering.mjs",
    "test:building-atlas": "node scripts/check-building-atlas.mjs",
    "test:terrain": "node scripts/terrain-check.mjs",
    "test:units": "node scripts/units-check.mjs",
    "test:fog": "node scripts/fog-check.mjs",
    "test:territory": "node scripts/territory-treasure-check.mjs",
    "test:diplomacy": "node scripts/diplomacy-popup-check.mjs",
    "test:culture": "node scripts/culture-monument-check.mjs",
    "test:monument-art": "node scripts/monument-chest-art-check.mjs",
    "test:hud": "node scripts/forged-hud-check.mjs && node scripts/hud-farms-check.mjs",
    "test:actions": "node scripts/forged-hud-check.mjs",
    "test:gates": "node scripts/gates-check.mjs",
    "test:mechanics": "node scripts/mechanics-visual-check.mjs",
    "test:orders": "node scripts/orders-economy-check.mjs",
    "test:shortcuts": "node scripts/forged-hud-check.mjs",
    "test:coasts": "node scripts/coasts-check.mjs",
    "build:wasm": "asc assembly/navigation.ts --outFile public/wasm/navigation.wasm --runtime stub --optimize --noAssert",
    "build:server": "npm run build:wasm && tsc --noEmit -p tsconfig.server.json && node scripts/build-multiplayer-server.mjs",
    "server": "node server-dist/server.mjs",
    "test:multiplayer": "node scripts/multiplayer-check.mjs",
    "test:multiplayer:browser": "node scripts/check-multiplayer-browser.mjs",
    "pages:prepare": "python3 scripts/prepare-pages.py",
    "test:ci": "node scripts/ci-tests.mjs"
  },
  "dependencies": {
    "bitecs": "0.4.0",
    "pixi.js": "8.22.0",
    "simplex-noise": "^4.0.3",
    "tinyqueue": "3.0.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "26.6.6",
    "@types/ws": "^8.18.2",
    "assemblyscript": "0.28.20",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
