{
  "name": "tinyciv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "world": "node scripts/world.mjs",
    "frozen": "node scripts/frozen.mjs",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run build:wasm && npm run test:rust && vitest run",
    "sim": "node tools/simulation-harness/cli.mjs",
    "benchmark:ai": "node tools/simulation-harness/cli.mjs ai",
    "test:ai": "npm run build:wasm && node rust/build.mjs test sim::ai_ && vitest run --dir tests faction-ai-policies.test.ts faction-strategy.test.ts rust-runtime.test.ts && node --test tools/simulation-harness/policies.test.mjs tools/simulation-harness/match.test.mjs tools/simulation-harness/search-space.test.mjs",
    "lab:navigation": "node scripts/build-navigation-lab.mjs",
    "lab:world": "node scripts/build-world-generation-lab.mjs",
    "lab:fractal": "node scripts/build-fractal-gallery.mjs",
    "gallery:puny": "python3 scripts/build-puny-gallery.py",
    "test:startup": "node scripts/startup-check.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:pixi": "node scripts/check-pixi-rendering.mjs",
    "test:building-atlas": "node scripts/check-building-atlas.mjs",
    "test:terrain": "node scripts/terrain-check.mjs",
    "test:units": "node scripts/units-check.mjs",
    "test:fog": "node scripts/fog-check.mjs",
    "test:territory": "node scripts/territory-treasure-check.mjs",
    "test:diplomacy": "node scripts/diplomacy-popup-check.mjs",
    "test:culture": "node scripts/culture-monument-check.mjs",
    "test:monument-art": "node scripts/monument-chest-art-check.mjs",
    "test:hud": "node scripts/forged-hud-check.mjs && node scripts/hud-farms-check.mjs",
    "test:actions": "node scripts/forged-hud-check.mjs",
    "test:gates": "node scripts/gates-check.mjs",
    "test:mechanics": "node scripts/mechanics-visual-check.mjs",
    "test:orders": "node scripts/orders-economy-check.mjs",
    "test:shortcuts": "node scripts/forged-hud-check.mjs",
    "test:coasts": "node scripts/coasts-check.mjs",
    "build:art": "python3 tools/runtime-art/build.py",
    "check:art": "python3 tools/runtime-art/build.py --check",
    "build:wasm": "node rust/build.mjs",
    "build:server": "npm run build:wasm && tsc --noEmit -p tsconfig.server.json && node rust/build-server.mjs",
    "server": "node server-dist/server.mjs",
    "test:multiplayer": "node scripts/multiplayer-check.mjs",
    "test:multiplayer:browser": "node scripts/check-multiplayer-browser.mjs",
    "pages:prepare": "python3 scripts/prepare-pages.py",
    "test:ci": "npm run test:rust && node scripts/ci-tests.mjs",
    "test:rust": "node rust/build.mjs test",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "ai:search": "node tools/simulation-harness/search.mjs",
    "build:scenarios": "npm run build:wasm && node tools/scenario-bake/build.mjs",
    "refine:scenarios": "npm run build:wasm && node tools/scenario-bake/refine.mjs"
  },
  "dependencies": {
    "msgpackr": "^2.1.4",
    "pg": "8.23.1",
    "pixi.js": "8.22.0",
    "simplex-noise": "^4.0.3",
    "tinyqueue": "3.0.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@storybook/html": "10.6.4",
    "@storybook/html-vite": "10.6.4",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.12",
    "storybook": "10.6.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
