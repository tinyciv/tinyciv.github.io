    "live": "node scripts/profile-live-state.mjs --state=<saved-state.json> --url=<server> --out=<results> --label=<name> --seconds=30",
    "pixels": "GAME_URL=<server> npm run test:pixi",
    "gameScenes": "node scripts/check-library-rendering.mjs --baseline=<baseline-server> --current=<candidate-server> --state=<saved-state.json> --out=<results>"
  }
}
